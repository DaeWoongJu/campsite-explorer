# 공공데이터포털(data.go.kr) > 고캠핑(GoCamping) API 활용신청 후 발급받은 디코딩(Decoding) 서비스키
GOCAMPING_API_KEY=

# 카카오 개발자(developers.kakao.com) > 애플리케이션 등록 후 발급받은 JavaScript 키
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Vercel 대시보드 > Storage 탭 > Upstash(Redis) 연결 시 자동으로 채워지는 값
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 관리자 페이지(/admin) 로그인 비밀번호 (직접 정하기)
ADMIN_PASSWORD=

